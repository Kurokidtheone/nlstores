# Public build-time values (not secrets) used when Cloudflare builds the app.
# Cloudflare "Build variables" with the same names override them; .env.local overrides them locally.
# Domain not bought yet: replace yourbrand.com here when it is (same as wrangler.jsonc vars).
NEXT_PUBLIC_ROOT_DOMAIN=yourbrand.com
NEXT_PUBLIC_ADMIN_HOST=admin.yourbrand.com
NEXT_PUBLIC_SALES_URL=https://example.com
