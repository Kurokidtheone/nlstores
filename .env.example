# Build-time variables (read by middleware.ts, baked into the build).
#
# Local development: cp .env.example .env.local  (keep the localhost values)
#
# Production: do NOT use a file. Set these 3 in Cloudflare → Workers & Pages →
# nl-stores → Settings → Build → Variables and secrets, with your real domain:
#   NEXT_PUBLIC_ROOT_DOMAIN=yourbrand.com
#   NEXT_PUBLIC_ADMIN_HOST=admin.yourbrand.com
#   NEXT_PUBLIC_SALES_URL=https://<your Next Level stores sales page>

NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_ADMIN_HOST=admin.localhost
NEXT_PUBLIC_SALES_URL=https://example.com
