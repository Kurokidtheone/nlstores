{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nl-stores",
  // worker.ts = the OpenNext app + the daily cron (scheduled handler)
  "main": "worker.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stores-db",
      // stores-db (Cloudflare D1)
      "database_id": "2e7e7bda-4315-4a3d-8806-5544f0c776e4",
      // Schema changes: a new numbered file in db/migrations/, never edit an applied one
      "migrations_dir": "db/migrations"
    }
  ],
  // Daily renewals job: 07:00 UTC = 08:00 Algeria (see worker.ts, lib/daily-job.ts)
  "triggers": { "crons": ["0 7 * * *"] },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      // Create with: npx wrangler r2 bucket create stores-media
      "bucket_name": "stores-media"
    }
  ],
  "vars": {
    // Domain not bought yet: replace yourbrand.com here AND in the 3 NEXT_PUBLIC_ build variables
    "ROOT_DOMAIN": "yourbrand.com",
    "ADMIN_HOST": "admin.yourbrand.com",
    "CF_ZONE_ID": "REPLACE_WITH_ZONE_ID"
  }
  // Secrets (never in this file): npx wrangler secret put SESSION_SECRET
  //                               npx wrangler secret put CF_API_TOKEN
  //                               npx wrangler secret put ADMIN_PASSWORD
}
