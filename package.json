{
  "name": "nl-stores",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build && node scripts/ci-migrate.mjs",
    "build:next": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "deploy:ci": "node scripts/ci-migrate.mjs && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply stores-db --local",
    "db:seed:local": "wrangler d1 execute stores-db --local --file=db/seed-demo.sql",
    "db:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply stores-db --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "next": "~15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "wrangler": "^4.156.1"
  }
}
